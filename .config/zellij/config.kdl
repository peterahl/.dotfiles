// Zellij-konfiguration anpassad för Helix + projekt-flikar (tmuxp-ersättare)
//
// Grundprincip:
// - Startar i "locked"-läge (default_mode "locked") så att Ctrl+g (Lazygit),
//   Ctrl+h/j/k/l (splits i Helix), Ctrl+p/n osv. ALDRIG krockar med Zellij.
// - Alt-genvägar fungerar alltid direkt (utan prefix) för snabba vardagsåtgärder.
// - Ctrl+a fungerar som prefix (precis som i din .tmux.conf) för allt annat,
//   och går automatiskt tillbaka till "locked"-läget efter utfört kommando.

keybinds clear-defaults=true {
    // --- Låst normalläge (standardläge när du jobbar i Helix / terminalen) ---
    locked {
        bind "Ctrl a" { SwitchToMode "tmux"; }
    }

    // Om något läge råkar skicka dig till "normal", håll det lika rent som "locked"
    normal {
        bind "Ctrl a" { SwitchToMode "tmux"; }
        bind "Esc" "Enter" { SwitchToMode "locked"; }
    }

    // --- Direkt-genvägar med Alt (aktiva överallt utom när man skriver in namn/sök) ---
    shared_except "renametab" "renamepane" "entersearch" {
        // Växla direkt mellan projektflikar (motsvarar M-1..M-9 i .tmux.conf)
        bind "Alt 1" { GoToTab 1; SwitchToMode "locked"; }
        bind "Alt 2" { GoToTab 2; SwitchToMode "locked"; }
        bind "Alt 3" { GoToTab 3; SwitchToMode "locked"; }
        bind "Alt 4" { GoToTab 4; SwitchToMode "locked"; }
        bind "Alt 5" { GoToTab 5; SwitchToMode "locked"; }
        bind "Alt 6" { GoToTab 6; SwitchToMode "locked"; }
        bind "Alt 7" { GoToTab 7; SwitchToMode "locked"; }
        bind "Alt 8" { GoToTab 8; SwitchToMode "locked"; }
        bind "Alt 9" { GoToTab 9; SwitchToMode "locked"; }

        // Toggla projektets svävande terminal (ersätter M-t / toggle_tmux_pane)
        bind "Alt t" { ToggleFloatingPanes; SwitchToMode "locked"; }

        // Zooma/unzooma nuvarande pane till helskärm (motsvarar M-f i .tmux.conf)
        bind "Alt f" { ToggleFocusFullscreen; SwitchToMode "locked"; }

        // Slaska upp en ny pane som stacked by default direkt i projektets mapp
        bind "Alt n" { NewPane "stacked"; SwitchToMode "locked"; }

        // Navigera mellan panes i Zellij med Alt+h/j/k/l (så Ctrl+h/j/k/l är fritt för Helix)
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }

        // Snabb storleksändring av aktiv pane
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }

        // Växla layout-utseende (t.ex. stacked panes)
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }

        // Öppna Session Manager direkt med Alt+w
        bind "Alt w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "locked"
        }
    }

    // --- Prefix-läge (Ctrl+a) - Mappar mot dina vanor från .tmux.conf ---
    tmux {
        bind "Esc" "Enter" "Ctrl g" { SwitchToMode "locked"; }

        // Ctrl+a följt av Ctrl+a skickar ett riktigt Ctrl+a till terminalen
        bind "Ctrl a" { Write 1; SwitchToMode "locked"; }

        // Splits i samma mapp (s/Ctrl+s = horisontellt/nedåt, v/Ctrl+v = vertikalt/höger)
        bind "s" "Ctrl s" "\"" "-" { NewPane "Down"; SwitchToMode "locked"; }
        bind "v" "Ctrl v" "%" "|" { NewPane "Right"; SwitchToMode "locked"; }

        // Docka in en floating pane som vanlig split, eller gör en vanlig split till floating
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "locked"; }
        bind "w" "t" { ToggleFloatingPanes; SwitchToMode "locked"; }

        // Zooma/unzooma (f eller z), växla layout stacked/split (Space) och toggla pane-ramar (b)
        bind "f" "z" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        bind "Space" { NextSwapLayout; SwitchToMode "locked"; }
        bind "b" "Ctrl b" { TogglePaneFrames; SwitchToMode "locked"; }

        // Flikar / Tabs (c/Ctrl+c = ny tab precis som i tmux)
        bind "c" "Ctrl c" "T" { NewTab; SwitchToMode "locked"; }
        bind "," "r" { SwitchToMode "renametab"; TabNameInput 0; }
        bind "." { SwitchToMode "renamepane"; PaneNameInput 0; }
        bind "Tab" { ToggleTab; SwitchToMode "locked"; }
        bind "p" { GoToPreviousTab; SwitchToMode "locked"; }
        bind "n" { GoToNextTab; SwitchToMode "locked"; }

        // Stäng aktiv pane (x) eller hel tab (X)
        bind "x" { CloseFocus; SwitchToMode "locked"; }
        bind "X" { CloseTab; SwitchToMode "locked"; }

        // Flytta fokus mellan panes
        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "locked"; }
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "locked"; }
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "locked"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "locked"; }
        bind "o" { FocusNextPane; SwitchToMode "locked"; }

        // Gå till Resize-läge (H/J/K/L ändrar storlek direkt, precis som i .tmux.conf)
        bind "H" { Resize "Increase Left"; SwitchToMode "resize"; }
        bind "J" { Resize "Increase Down"; SwitchToMode "resize"; }
        bind "K" { Resize "Increase Up"; SwitchToMode "resize"; }
        bind "L" { Resize "Increase Right"; SwitchToMode "resize"; }
        bind "R" { SwitchToMode "resize"; }

        // Gå till Move-läge (flytta runt panes)
        bind "m" { SwitchToMode "move"; }

        // Scroll & sök i terminalhistorik ([ eller Ctrl+f eller /)
        bind "[" "Ctrl f" "/" { SwitchToMode "scroll"; }

        // Session-hantering: d = detach, s/w = session-manager, q = avsluta
        bind "d" { Detach; }
        bind "S" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "locked"
        }
        bind "q" { Quit; }
    }

    // --- Resize-läge (nås via Ctrl+a -> H/J/K/L eller R) ---
    resize {
        bind "Esc" "Enter" "Ctrl c" "Ctrl g" "q" { SwitchToMode "locked"; }
        bind "h" "H" "Left" { Resize "Increase Left"; }
        bind "j" "J" "Down" { Resize "Increase Down"; }
        bind "k" "K" "Up" { Resize "Increase Up"; }
        bind "l" "L" "Right" { Resize "Increase Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    // --- Move-läge (nås via Ctrl+a -> m) ---
    move {
        bind "Esc" "Enter" "Ctrl c" "Ctrl g" "q" { SwitchToMode "locked"; }
        bind "n" "Tab" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
    }

    // --- Scroll & Sök-läge (nås via Ctrl+a -> [ eller /) ---
    scroll {
        bind "Esc" "Enter" "q" "Ctrl c" { ScrollToBottom; SwitchToMode "locked"; }
        bind "e" { EditScrollback; SwitchToMode "locked"; }
        bind "s" "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" "Ctrl d" { HalfPageScrollDown; }
        bind "u" "Ctrl u" { HalfPageScrollUp; }
    }

    search {
        bind "Esc" "Enter" "q" "Ctrl c" { ScrollToBottom; SwitchToMode "locked"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" "Ctrl d" { HalfPageScrollDown; }
        bind "u" "Ctrl u" { HalfPageScrollUp; }
        bind "n" { Search "down"; }
        bind "p" "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "scroll"; }
        bind "Enter" { SwitchToMode "search"; }
    }

    renametab {
        bind "Ctrl c" "Enter" { SwitchToMode "locked"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "locked"; }
    }

    renamepane {
        bind "Ctrl c" "Enter" { SwitchToMode "locked"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "locked"; }
    }
}

plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    filepicker location="zellij:strider" {
        cwd "/"
    }
}

// Starta alltid i locked-läge så att Helix får alla Ctrl-genvägar
default_mode "locked"

// Använd projekt-layouten som standard när du startar en ny Zellij-session
default_layout "projects"

// Matcha ditt Helix-tema (catppuccin_mocha)
theme "catppuccin-mocha"

// Pane-ramar behövs för att staplade panes (Alt+n) ska visa sina titlar i stapeln.
// Du kan när som helst toggla ramar av/på med Ctrl+a -> b
pane_frames true

// Spara sessioner i bakgrunden så de kan återupptas vid omstart
session_serialization true
scroll_buffer_size 10000
mouse_mode true
